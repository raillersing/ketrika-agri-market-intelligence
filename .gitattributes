# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# PowerShell supports LF; keep the normative repository-wide line ending.
*.ps1 text eol=lf

# Shell scripts must strictly use LF
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.xls binary
*.parquet binary
*.geoparquet binary
*.db binary
*.sqlite binary

# ADR-014: preserve the exact bytes of officially acquired corpus responses.
backend/tests/fixtures/authentic/** -text
