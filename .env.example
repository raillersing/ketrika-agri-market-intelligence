# ==============================================================================
# Ketrika Agri Market Intelligence - Environment Configuration
# ==============================================================================

# --- Général
APP_ENV=dev
TZ_BUSINESS=Indian/Antananarivo
LOG_LEVEL=INFO

# --- Ports d'hôte (ADR-007 : configurables pour éviter les conflits locaux)
POSTGRES_PORT=5434
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
API_PORT=8090
DAGSTER_PORT=3010
WEB_PORT=3005
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- Base de données
POSTGRES_USER=ketrika
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ketrika
DATABASE_URL=postgresql+psycopg://ketrika:change-me@db:5432/ketrika
DAGSTER_PG_DB=dagster
COPILOT_DB_PASSWORD=change-me-ro

# --- Stockage objet (MinIO en dev, R2 en prod)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_BRONZE=bronze
S3_REGION=auto

# --- Collecte
BOT_USER_AGENT=KetrikaAgriBot/0.1 (+https://ketrika.ai/bot)
BOT_CONTACT_EMAIL=contact@example.com
HTTP_OFFLINE=0
HTTP_DEFAULT_MAX_RPS=0.2

# --- LLM
LLM_PROVIDER=replay
LLM_MODEL_EXTRACT=gemini-2.5-flash
LLM_MODEL_REASON=gemini-2.5-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MONTHLY_BUDGET_USD=20
LLM_PER_RUN_BUDGET_USD=5

# --- API / Auth
JWT_SECRET=change-me-long-random-secret-key-32chars
JWT_TTL_MINUTES=720
DEMO_ADMIN_EMAIL=admin@ketrika.local
DEMO_ADMIN_PASSWORD=change-me
CORS_ORIGINS=http://localhost:3005

# --- Notifications
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=bulletin@ketrika.local
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EXTERNAL_SEND_ENABLED=0

# --- Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8090
API_INTERNAL_URL=http://api:8000
MAP_STYLE_URL=
